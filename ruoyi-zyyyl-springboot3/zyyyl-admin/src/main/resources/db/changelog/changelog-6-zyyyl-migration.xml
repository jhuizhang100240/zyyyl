    <changeSet id="20260930-11-dedupe-contract-number" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="contract"/>
            <not>
                <indexExists indexName="uk_contract_number" tableName="contract"/>
            </not>
        </preConditions>
        <sql>
            DELETE c FROM contract c
            JOIN (
                SELECT contract_number, MIN(id) AS keep_id
                FROM contract
                WHERE contract_number IS NOT NULL AND contract_number != ''
                GROUP BY contract_number
                HAVING COUNT(*) &gt; 1
            ) dup ON dup.contract_number = c.contract_number
            WHERE c.id &lt;&gt; dup.keep_id;
        </sql>
        <rollback>
            <!-- 去重删除的历史数据无法恢复，回滚只移除后续索引 -->
        </rollback>
    </changeSet>

    <changeSet id="20260930-12-create-contract-number-unique-index" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="contract"/>
            <not>
                <indexExists indexName="uk_contract_number" tableName="contract"/>
            </not>
        </preConditions>
        <createIndex indexName="uk_contract_number" tableName="contract" unique="true">
            <column name="contract_number"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="uk_contract_number" tableName="contract"/>
        </rollback>
    </changeSet>

    <changeSet id="20260930-13-dedupe-elder-id-card" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="elder"/>
            <not>
                <indexExists indexName="uk_elder_id_card_no" tableName="elder"/>
            </not>
        </preConditions>
        <sql>
            CREATE TEMPORARY TABLE tmp_elder_dedupe AS
            SELECT id_card_no, MIN(id) AS keep_id
            FROM elder
            WHERE id_card_no IS NOT NULL AND id_card_no != ''
            GROUP BY id_card_no
            HAVING COUNT(*) &gt; 1;

            UPDATE check_in ci
            JOIN tmp_elder_dedupe t ON ci.elder_id != t.keep_id
            JOIN elder e ON e.id = ci.elder_id AND e.id_card_no = t.id_card_no
            SET ci.elder_id = t.keep_id;

            UPDATE contract c
            JOIN tmp_elder_dedupe t ON c.elder_id != t.keep_id
            JOIN elder e ON e.id = c.elder_id AND e.id_card_no = t.id_card_no
            SET c.elder_id = t.keep_id;

            DELETE FROM family_member_elder
            WHERE id IN (
                SELECT id FROM (
                    SELECT fme.id,
                           ROW_NUMBER() OVER (
                               PARTITION BY fme.family_member_id, e.id_card_no
                               ORDER BY fme.id
                           ) AS rn
                    FROM family_member_elder fme
                    JOIN elder e ON e.id = fme.elder_id
                    WHERE e.id_card_no IS NOT NULL AND e.id_card_no != ''
                ) ranked
                WHERE ranked.rn &gt; 1
            );

            UPDATE family_member_elder f
            JOIN tmp_elder_dedupe t ON f.elder_id != t.keep_id
            JOIN elder e ON e.id = f.elder_id AND e.id_card_no = t.id_card_no
            SET f.elder_id = t.keep_id;

            UPDATE nursing_task nt
            JOIN tmp_elder_dedupe t ON nt.elder_id != t.keep_id
            JOIN elder e ON e.id = nt.elder_id AND e.id_card_no = t.id_card_no
            SET nt.elder_id = t.keep_id;

            DELETE e FROM elder e
            JOIN tmp_elder_dedupe t ON e.id_card_no = t.id_card_no
            WHERE e.id != t.keep_id;

            DROP TEMPORARY TABLE tmp_elder_dedupe;
        </sql>
        <rollback>
            <!-- 去重删除的历史数据无法恢复，回滚只移除后续索引 -->
        </rollback>
    </changeSet>

    <changeSet id="20260930-14-create-elder-id-card-unique-index" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="elder"/>
