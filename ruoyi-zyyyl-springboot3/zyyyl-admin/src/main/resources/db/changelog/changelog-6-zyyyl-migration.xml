<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      阶段六：新增表、去重、索引与旧数据迁移。
      说明：所有 changeSet 均可重复执行；索引使用 preConditions 防重复创建，
      去重与回填使用幂等 SQL，已执行的 changeSet 不再修改。
    -->

    <changeSet id="20260930-06-create-check-in-family" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="check_in"/>
            <not>
                <tableExists tableName="check_in_family"/>
            </not>
        </preConditions>
        <createTable tableName="check_in_family" remarks="入住家属联系人">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="check_in_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="family_name" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="relation" type="VARCHAR(32)"/>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="is_primary" type="TINYINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="create_time" type="DATETIME"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="update_time" type="DATETIME"/>
            <column name="remark" type="VARCHAR(500)"/>
        </createTable>
        <createIndex indexName="idx_check_in_family_main" tableName="check_in_family">
            <column name="check_in_id"/>
            <column name="is_primary"/>
        </createIndex>
        <rollback>
            <dropTable tableName="check_in_family"/>
        </rollback>
    </changeSet>

    <changeSet id="20260930-07-add-task-assignee-columns" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="nursing_task_assignee"/>
            <not>
                <columnExists tableName="nursing_task_assignee" columnName="assign_status"/>
            </not>
        </preConditions>
        <addColumn tableName="nursing_task_assignee">
            <column name="assign_status" type="TINYINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="assign_time" type="DATETIME"/>
            <column name="complete_time" type="DATETIME"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="nursing_task_assignee" columnName="assign_status"/>
            <dropColumn tableName="nursing_task_assignee" columnName="assign_time"/>
            <dropColumn tableName="nursing_task_assignee" columnName="complete_time"/>
        </rollback>
    </changeSet>

    <changeSet id="20260930-08-create-task-assignee-status-index" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="nursing_task_assignee"/>
            <columnExists tableName="nursing_task_assignee" columnName="assign_status"/>
            <not>
                <indexExists indexName="idx_assignee_nursing_status"
                    tableName="nursing_task_assignee"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_assignee_nursing_status"
            tableName="nursing_task_assignee">
            <column name="nursing_id"/>
            <column name="assign_status"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_assignee_nursing_status"
                tableName="nursing_task_assignee"/>
        </rollback>
    </changeSet>

    <changeSet id="20260930-09-create-care-alert-rule" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="care_alert_rule"/>
            </not>
        </preConditions>
        <createTable tableName="care_alert_rule" remarks="风险提示规则">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rule_code" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="threshold_value" type="DECIMAL(10,2)"/>
            <column name="threshold_unit" type="VARCHAR(32)"/>
            <column name="severity" type="TINYINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="TINYINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" type="VARCHAR(64)"/>
            <column name="create_time" type="DATETIME"/>
            <column name="update_by" type="VARCHAR(64)"/>
            <column name="update_time" type="DATETIME"/>
