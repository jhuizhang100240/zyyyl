    <changeSet id="20260930-16-backfill-task-assignees" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="nursing_task"/>
            <tableExists tableName="nursing_task_assignee"/>
            <columnExists tableName="nursing_task_assignee" columnName="assign_status"/>
        </preConditions>
        <sql>
            INSERT INTO nursing_task_assignee (task_id, nursing_id, assign_status, assign_time, remark)
            SELECT t.id,
                   CAST(TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(t.nursing_id, ',', n.idx), ',', -1)) AS UNSIGNED),
                   0,
                   NOW(),
                   'stage6-backfill'
            FROM nursing_task t
            JOIN (SELECT 1 AS idx UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4
                  UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8) n
              ON n.idx &lt;= 1 + LENGTH(t.nursing_id) - LENGTH(REPLACE(t.nursing_id, ',', ''))
            WHERE t.nursing_id IS NOT NULL
              AND t.nursing_id != ''
              AND TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(t.nursing_id, ',', n.idx), ',', -1)) REGEXP '^[0-9]+$'
              AND NOT EXISTS (
                  SELECT 1 FROM nursing_task_assignee a
                  WHERE a.task_id = t.id
                    AND a.nursing_id = CAST(TRIM(SUBSTRING_INDEX(SUBSTRING_INDEX(t.nursing_id, ',', n.idx), ',', -1)) AS UNSIGNED)
              );
        </sql>
        <rollback>
            <sql>
                DELETE FROM nursing_task_assignee
                WHERE remark = 'stage6-backfill';
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="20260930-18-upgrade-family-elder-unique-index" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="family_member_elder"/>
            <not>
                <indexExists indexName="uk_family_member_elder"
                    tableName="family_member_elder"/>
            </not>
        </preConditions>
        <sql>
            DELETE FROM family_member_elder
             WHERE family_member_id IS NULL
                OR elder_id IS NULL;
        </sql>
        <sql>
            DELETE FROM family_member_elder
            WHERE id IN (
                SELECT id FROM (
                    SELECT id,
                           ROW_NUMBER() OVER (
                               PARTITION BY family_member_id, elder_id ORDER BY id
                           ) AS rn
                    FROM family_member_elder
                ) ranked
                WHERE ranked.rn &gt; 1
            );
        </sql>
        <sql>
            ALTER TABLE family_member_elder
                MODIFY COLUMN family_member_id BIGINT NOT NULL,
                MODIFY COLUMN elder_id BIGINT NOT NULL;
        </sql>
        <createIndex indexName="uk_family_member_elder" tableName="family_member_elder"
            unique="true">
            <column name="family_member_id"/>
            <column name="elder_id"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="uk_family_member_elder" tableName="family_member_elder"/>
        </rollback>
    </changeSet>

    <changeSet id="20260930-17-backfill-check-in-family" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="check_in"/>
            <tableExists tableName="check_in_family"/>
        </preConditions>
        <sql>
            INSERT INTO check_in_family
                (check_in_id, family_name, relation, phone, is_primary, create_time, remark)
            SELECT ci.id,
                   COALESCE(NULLIF(JSON_UNQUOTE(JSON_EXTRACT(item.value, '$.name')), 'null'), '未填写'),
                   NULLIF(JSON_UNQUOTE(JSON_EXTRACT(item.value, '$.kinship')), 'null'),
                   NULLIF(JSON_UNQUOTE(JSON_EXTRACT(item.value, '$.phone')), 'null'),
                   CASE WHEN item.ord = 1 THEN 1 ELSE 0 END,
                   NOW(),
                   'stage6-backfill'
            FROM check_in ci
            JOIN JSON_TABLE(
                    ci.remark,
                    '$[*]' COLUMNS (
                        ord FOR ORDINALITY,
                        value JSON PATH '$'
                    )
                 ) item
            WHERE ci.remark IS NOT NULL
              AND ci.remark != ''
              AND JSON_VALID(ci.remark)
              AND NOT EXISTS (
                  SELECT 1 FROM check_in_family f WHERE f.check_in_id = ci.id
              );
        </sql>
        <rollback>
            <sql>
                DELETE FROM check_in_family WHERE remark = 'stage6-backfill';
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
