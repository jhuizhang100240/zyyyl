            <not>
                <tableExists tableName="care_alert"/>
            </not>
        </preConditions>
        <createTable tableName="care_alert" remarks="护理风险提示">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="elder_id" type="BIGINT"/>
            <column name="rule_code" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="alert_title" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="alert_content" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="TINYINT">
                <constraints nullable="false"/>
            </column>
            <column name="source_type" type="VARCHAR(32)"/>
            <column name="source_id" type="BIGINT"/>
            <column name="status" type="TINYINT" defaultValueNumeric="0">
