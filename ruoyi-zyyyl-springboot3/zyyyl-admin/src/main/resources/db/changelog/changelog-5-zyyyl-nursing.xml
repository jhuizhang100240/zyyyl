<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260930-01-create-nursing-project-plan-index" author="zyyyl">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="nursing_project_plan"/>
            <not>
                <indexExists indexName="idx_nursing_project_plan_plan_id"
                    tableName="nursing_project_plan"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_nursing_project_plan_plan_id"
            tableName="nursing_project_plan">
            <column name="plan_id"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_nursing_project_plan_plan_id"
                tableName="nursing_project_plan"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
