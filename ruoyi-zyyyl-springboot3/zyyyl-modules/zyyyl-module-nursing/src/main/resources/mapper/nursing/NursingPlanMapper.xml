<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyyyl.nursing.mapper.NursingPlanMapper">

    <resultMap id="NursingPlanResult" type="com.zyyyl.nursing.domain.NursingPlan">
        <id property="id" column="id"/>
        <result property="sortNo" column="sort_no"/>
        <result property="planName" column="plan_name"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="selectNursingPlanList" parameterType="com.zyyyl.nursing.domain.NursingPlan"
            resultMap="NursingPlanResult">
        select id, sort_no, plan_name, status, create_by, create_time,
               update_by, update_time, remark
        from nursing_plan
        <where>
            <if test="planName != null and planName != ''">and plan_name like concat('%', #{planName}, '%')</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by sort_no, id
    </select>

    <select id="listAll" resultMap="NursingPlanResult">
        select id, sort_no, plan_name, status, create_by, create_time,
               update_by, update_time, remark
        from nursing_plan
        where status = 1
        order by sort_no, id
    </select>

</mapper>
