<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyyyl.nursing.mapper.BedMapper">

    <resultMap id="BedResult" type="com.zyyyl.nursing.domain.Bed">
        <id property="id" column="id"/>
        <result property="bedNumber" column="bed_number"/>
        <result property="bedStatus" column="bed_status"/>
        <result property="sort" column="sort"/>
        <result property="roomId" column="room_id"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="bedColumns">
        id, bed_number, bed_status, sort, room_id, create_by, create_time, update_by, update_time, remark
    </sql>

    <select id="selectBedList" parameterType="com.zyyyl.nursing.domain.Bed" resultMap="BedResult">
        select <include refid="bedColumns"/>
        from bed
        <where>
            <if test="bedNumber != null and bedNumber != ''">and bed_number = #{bedNumber}</if>
            <if test="bedStatus != null">and bed_status = #{bedStatus}</if>
            <if test="sort != null">and sort = #{sort}</if>
            <if test="roomId != null">and room_id = #{roomId}</if>
        </where>
        order by sort, id
    </select>

    <select id="selectBedForUpdate" resultMap="BedResult">
        select <include refid="bedColumns"/>
        from bed
        where id = #{id}
        for update
    </select>

</mapper>
