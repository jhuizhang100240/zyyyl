<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyyyl.nursing.mapper.ReservationMapper">

    <resultMap id="ReservationResult" type="com.zyyyl.nursing.domain.Reservation">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="mobile" column="mobile"/>
        <result property="time" column="time"/>
        <result property="visitor" column="visitor"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="reservationColumns">
        id, name, mobile, time, visitor, type, status,
        create_by, create_time, update_by, update_time, remark
    </sql>

    <select id="selectReservationList" parameterType="com.zyyyl.nursing.dto.ReservationQueryDto"
            resultMap="ReservationResult">
        select <include refid="reservationColumns"/>
        from reservation
        <where>
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="mobile != null and mobile != ''">and mobile = #{mobile}</if>
            <if test="startTime != null and endTime != null">and time between #{startTime} and #{endTime}</if>
            <if test="type != null">and type = #{type}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by time desc
    </select>

    <select id="selectByPage" resultMap="ReservationResult">
        select <include refid="reservationColumns"/>
        from reservation
        <where>
            <if test="status != null">and status = #{status}</if>
            <if test="userId != null">and create_by = #{userId}</if>
        </where>
        order by time desc
        limit #{startIndex}, #{pageSize}
    </select>

    <select id="count" resultType="int">
        select count(1)
        from reservation
        <where>
            <if test="status != null">and status = #{status}</if>
            <if test="userId != null">and create_by = #{userId}</if>
        </where>
    </select>

    <select id="countByTime" resultType="int">
        select count(1)
        from reservation
        where time = #{time}
          and status = 0
        for update
    </select>

    <select id="selectActiveByTimeForUpdate" resultMap="ReservationResult">
        select <include refid="reservationColumns"/>
        from reservation
        where time = #{time}
          and status = 0
        for update
    </select>

    <select id="countByTimeAndMobile" resultType="int">
        select count(1)
        from reservation
        where time = #{time}
          and mobile = #{mobile}
    </select>

    <select id="acquireTimeSlotLock" resultType="java.lang.Integer">
        select get_lock(#{lockName}, 5)
    </select>

    <select id="releaseTimeSlotLock" resultType="java.lang.Integer">
        select release_lock(#{lockName})
    </select>

    <select id="selectExpired" resultMap="ReservationResult">
        select <include refid="reservationColumns"/>
        from reservation
        where time &lt;= #{now}
          and status = 0
    </select>

    <select id="selectByDate" resultMap="ReservationResult">
        select <include refid="reservationColumns"/>
        from reservation
        where time &gt;= #{startTime}
          and time &lt; #{endTime}
        order by time
    </select>

    <select id="getCountByTime" resultType="com.zyyyl.nursing.vo.TimeCountVo">
        select time, 6 - count(1) as count
        from reservation
        where status = 0
          and time between #{startTime} and #{endTime}
        group by time
        order by time
    </select>

    <select id="cancelledCount" resultType="int">
        select count(1)
        from reservation
        where status = 2
          and update_by = #{userId}
          and update_time between #{startTime} and #{endTime}
    </select>

</mapper>
