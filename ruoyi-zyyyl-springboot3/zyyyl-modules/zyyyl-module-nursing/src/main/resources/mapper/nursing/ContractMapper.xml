<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zyyyl.nursing.mapper.ContractMapper">

    <resultMap id="ContractResult" type="com.zyyyl.nursing.domain.Contract">
        <id property="id" column="id"/>
        <result property="elderId" column="elder_id"/>
        <result property="contractName" column="contract_name"/>
        <result property="contractNumber" column="contract_number"/>
        <result property="agreementPath" column="agreement_path"/>
        <result property="thirdPartyPhone" column="third_party_phone"/>
        <result property="thirdPartyName" column="third_party_name"/>
        <result property="elderName" column="elder_name"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="status" column="status"/>
        <result property="signDate" column="sign_date"/>
        <result property="terminationSubmitter" column="termination_submitter"/>
        <result property="terminationDate" column="termination_date"/>
        <result property="terminationAgreementPath" column="termination_agreement_path"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="contractColumns">
        id, elder_id, contract_name, contract_number, agreement_path,
        third_party_phone, third_party_name, elder_name, start_date, end_date,
        status, sign_date, termination_submitter, termination_date,
        termination_agreement_path, sort_order, remark,
        create_by, create_time, update_by, update_time
    </sql>

    <select id="selectContractList" parameterType="com.zyyyl.nursing.domain.Contract" resultMap="ContractResult">
        select <include refid="contractColumns"/>
        from contract
        <where>
            <if test="elderId != null">and elder_id = #{elderId}</if>
            <if test="contractName != null and contractName != ''">
                and contract_name like concat('%', #{contractName}, '%')
            </if>
            <if test="contractNumber != null and contractNumber != ''">and contract_number = #{contractNumber}</if>
            <if test="agreementPath != null and agreementPath != ''">and agreement_path = #{agreementPath}</if>
            <if test="thirdPartyPhone != null and thirdPartyPhone != ''">and third_party_phone = #{thirdPartyPhone}</if>
            <if test="thirdPartyName != null and thirdPartyName != ''">
                and third_party_name like concat('%', #{thirdPartyName}, '%')
            </if>
            <if test="elderName != null and elderName != ''">and elder_name like concat('%', #{elderName}, '%')</if>
            <if test="startDate != null">and start_date = #{startDate}</if>
            <if test="endDate != null">and end_date = #{endDate}</if>
            <if test="status != null">and status = #{status}</if>
            <if test="signDate != null">and sign_date = #{signDate}</if>
            <if test="sortOrder != null">and sort_order = #{sortOrder}</if>
        </where>
        order by id desc
    </select>

    <select id="selectByElderId" resultMap="ContractResult">
        select <include refid="contractColumns"/>
        from contract
        where elder_id = #{elderId}
        order by id desc
        limit 1
    </select>

    <select id="countByContractNumber" resultType="int">
        select count(1)
        from contract
        where contract_number = #{contractNumber}
    </select>

    <select id="countByContractNumberExcludingId" resultType="int">
        select count(1)
        from contract
        where contract_number = #{contractNumber}
          and id &lt;&gt; #{id}
    </select>

</mapper>
